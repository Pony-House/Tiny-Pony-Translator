{
  "name": "tiny-pony-translator",
  "productName": "Tiny Pony Translator",
  "version": "1.0.1",
  "description": "A lightweight and open-source translation tool supporting LibreTranslate and OpenAI-compatible APIs.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Yasmin Seidel (JasminDreasond)",
    "email": "tiny@puddy.club",
    "url": "https://www.npmjs.com/~jasmindreasond"
  },
  "homepage": "https://github.com/Pony-House/Tiny-Pony-Translator",
  "license": "AGPL-3.0-only",
  "keywords": [
    "translator",
    "libretranslate",
    "openai",
    "llm",
    "json-translator",
    "tiny-pony-translator",
    "electron",
    "react",
    "vite"
  ],
  "scripts": {
    "fix:prettier": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "web:dev": "vite --config vite.web.config.mjs",
    "web:build": "vite build --config vite.web.config.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.jasmindreasond.tiny-pony-translator",
    "productName": "Tiny Pony Translator",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "node_modules/**/*",
      "build/**/*",
      "out/**/*",
      "package.json",
      "package-lock.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office"
    },
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@popperjs/core": "^2.11.8",
    "ansi-to-react": "^6.2.6",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron-updater": "^6.3.9",
    "tiny-essentials": "^1.25.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sass": "^1.99.0",
    "vite": "^7.2.6"
  }
}
